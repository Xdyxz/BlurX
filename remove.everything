-- Hindustanhack: Part Remover
-- Safe Part = static anchored slab named "partscriptremover", spawns under you once, never moves
-- Works on Xeno + Delta executors

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer
local SAFE_NAME   = "partscriptremover"
local COIN_NAME   = "Coin_Server"

-- ============================================================
-- State
-- ============================================================
local SafePart = { Enabled = false, Part = nil, CharAdded = nil }
local Looper   = { Enabled = false, Thread = nil, Delay = 1 }

-- ============================================================
-- Protection checks
-- ============================================================
local function isCharacterPart(part)
    if not part or not part:IsA("BasePart") then return true end
    local model = part:FindFirstAncestorOfClass("Model")
    while model do
        if model:FindFirstChildOfClass("Humanoid") then return true end
        if Players:GetPlayerFromCharacter(model) then return true end
        model = model:FindFirstAncestorOfClass("Model")
    end
    return false
end

local function isInProtectedTree(part)
    local node = part
    while node and node ~= Workspace do
        local n = node.Name
        if n == COIN_NAME or n == SAFE_NAME then return true end
        node = node.Parent
    end
    return false
end

local function isProtected(part)
    if isCharacterPart(part) then return true end
    if isInProtectedTree(part) then return true end
    if SafePart.Part and part == SafePart.Part then return true end
    return false
end

-- ============================================================
-- Nuke
-- ============================================================
local function nukeParts()
    local removed = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not isProtected(obj) then
            pcall(function() obj:Destroy() end)
            removed += 1
        end
    end
    return removed
end

-- ============================================================
-- Safe Part (static, no movement)
-- ============================================================
local function stopSafePart()
    if SafePart.CharAdded then SafePart.CharAdded:Disconnect(); SafePart.CharAdded = nil end
    if SafePart.Part then pcall(function() SafePart.Part:Destroy() end); SafePart.Part = nil end
end

local function spawnSafePart()
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if SafePart.Part then pcall(function() SafePart.Part:Destroy() end) end

    local slab = Instance.new("Part")
    slab.Name         = SAFE_NAME
    slab.Size         = Vector3.new(60, 1, 60)
    slab.Anchored     = true
    slab.CanCollide   = true
    slab.Material     = Enum.Material.Neon
    slab.Color        = Color3.fromRGB(0, 255, 120)
    slab.Transparency = 0.4
    slab.Position     = hrp.Position - Vector3.new(0, 3.5, 0)
    slab.Parent       = Workspace
    SafePart.Part     = slab
end

local function setSafePart(on)
    SafePart.Enabled = on
    if on then
        stopSafePart()
        spawnSafePart()
        -- only respawn if the character actually respawns (the slab does not follow)
        SafePart.CharAdded = LocalPlayer.CharacterAdded:Connect(function()
            task.wait(1)
            if SafePart.Enabled then spawnSafePart() end
        end)
    else
        stopSafePart()
    end
end

-- ============================================================
-- Looper
-- ============================================================
local function stopLooper()
    Looper.Enabled = false
    if Looper.Thread then
        pcall(function() task.cancel(Looper.Thread) end)
        Looper.Thread = nil
    end
end

local function startLooper(statusLabel, loopBtn)
    Looper.Enabled = true
    Looper.Thread = task.spawn(function()
        while Looper.Enabled do
            local count = nukeParts()
            if SafePart.Enabled and not SafePart.Part then spawnSafePart() end
            if statusLabel then
                statusLabel.Text = ("Loop removed %d parts"):format(count)
                statusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
            end
            task.wait(Looper.Delay)
        end
        if loopBtn then
            loopBtn.Text = "Loop Remover"
            loopBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
            loopBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        if statusLabel then
            statusLabel.Text = "Loop stopped"
            statusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
    end)
end

-- ============================================================
-- GUI
-- ============================================================
local old = CoreGui:FindFirstChild("HindustanPartRemover")
if old then old:Destroy() end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "HindustanPartRemover"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = CoreGui

local Main = Instance.new("Frame")
Main.Size = UDim2.new(0, 280, 0, 300)
Main.Position = UDim2.new(0.5, -140, 0.5, -150)
Main.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
Main.BorderSizePixel = 0
Main.Active = true
Main.Parent = ScreenGui
Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 8)

local TopBar = Instance.new("Frame")
TopBar.Size = UDim2.new(1, 0, 0, 30)
TopBar.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
TopBar.BorderSizePixel = 0
TopBar.Parent = Main
Instance.new("UICorner", TopBar).CornerRadius = UDim.new(0, 8)

