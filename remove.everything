-- Hindustanhack: One-Shot Part Remover GUI + Floor Saver Toggle
-- Works on Xeno + Delta executors

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

-- ============================================================
-- State
-- ============================================================
local FloorSaver = {
    Enabled = false,
    Part    = nil,
    Conn    = nil,
}

-- ============================================================
-- Safety: protected character parts
-- ============================================================
local function isProtected(part)
    if not part or not part:IsA("BasePart") then return true end
    local model = part:FindFirstAncestorOfClass("Model")
    while model do
        if model:FindFirstChildOfClass("Humanoid") then return true end
        if Players:GetPlayerFromCharacter(model) then return true end
        model = model:FindFirstAncestorOfClass("Model")
    end
    return false
end

-- ============================================================
-- Nuke
-- ============================================================
local function nukeParts()
    local removed = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not isProtected(obj) then
            if not (FloorSaver.Part and obj == FloorSaver.Part) then
                pcall(function() obj:Destroy() end)
                removed += 1
            end
        end
    end
    return removed
end

-- ============================================================
-- Floor saver
-- ============================================================
local function stopFloor()
    if FloorSaver.Conn then FloorSaver.Conn:Disconnect(); FloorSaver.Conn = nil end
    if FloorSaver.Part then pcall(function() FloorSaver.Part:Destroy() end); FloorSaver.Part = nil end
end

local function spawnFloor()
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local floor = Instance.new("Part")
    floor.Name          = "HindustanFloor"
    floor.Size          = Vector3.new(60, 1, 60)
    floor.Anchored      = true
    floor.CanCollide     = true
    floor.Material      = Enum.Material.Neon
    floor.Color         = Color3.fromRGB(0, 255, 120)
    floor.Transparency  = 0.4
    floor.Position      = hrp.Position - Vector3.new(0, 3.5, 0)
    floor.Parent        = Workspace
    FloorSaver.Part     = floor

    FloorSaver.Conn = RunService.Heartbeat:Connect(function()
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChild("HumanoidRootPart")
        if not h or not FloorSaver.Part then return end
        FloorSaver.Part.Position = Vector3.new(h.Position.X, h.Position.Y - 3.5, h.Position.Z)
    end)
end

local function startFloor()
    stopFloor()
    spawnFloor()

    -- if character respawns, re-attach floor
    FloorSaver.CharAdded = LocalPlayer.CharacterAdded:Connect(function()
        task.wait(1)
        if FloorSaver.Enabled then spawnFloor() end
    end)
end

local function setFloor(on)
    FloorSaver.Enabled = on
    if on then
        startFloor()
    else
        if FloorSaver.CharAdded then FloorSaver.CharAdded:Disconnect(); FloorSaver.CharAdded = nil end
        stopFloor()
    end
end

-- ============================================================
-- GUI
-- ============================================================
local old = CoreGui:FindFirstChild("HindustanNukeGui")
if old then old:Destroy() end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "HindustanNukeGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = CoreGui

local Main = Instance.new("Frame")
Main.Size = UDim2.new(0, 280, 0, 210)
Main.Position = UDim2.new(0.5, -140, 0.5, -105)
Main.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
Main.BorderSizePixel = 0
Main.Active = true
Main.Parent = ScreenGui
Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 8)

local TopBar = Instance.new("Frame")
TopBar.Size = UDim2.new(1, 0, 0, 30)
TopBar.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
TopBar.BorderSizePixel = 0
TopBar.Parent = Main
Instance.new("UICorner", TopBar).CornerRadius = UDim.new(0, 8)

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, -34, 1, 0)
Title.Position = UDim2.new(0, 10, 0, 0)
Title.BackgroundTransparency = 1
Title.Text = "Hindustan Nuke"
Title.TextColor3 = Color3.fromRGB(0, 255, 120)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 14
Title.TextXAlignment = Enum.TextXAlignment.Left
Title.Parent = TopBar

local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.new(0, 24, 0, 24)
CloseBtn.Position = UDim2.new(1, -28, 0, 3)
CloseBtn.BackgroundColor3 = Color3.fromRGB(60, 30, 30)
CloseBtn.BorderSizePixel = 0
CloseBtn.Text = "X"
CloseBtn.TextColor3 = Color3.fromRGB(255, 120, 120)
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.TextSize = 14
CloseBtn.Parent = TopBar
Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 6)

local NukeBtn = Instance.new("TextButton")
NukeBtn.Size = UDim2.new(1, -20, 0, 50)
NukeBtn.Position = UDim2.new(0, 10, 0, 42)
NukeBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
NukeBtn.BorderSizePixel = 0
NukeBtn.Text = "REMOVE ALL PARTS"
NukeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
NukeBtn.Font = Enum.Font.GothamBold
NukeBtn.TextSize = 13
NukeBtn.Parent = Main
Instance.new("UICorner", NukeBtn).CornerRadius = UDim.new(0, 6)

-- Floor toggle
local FloorBtn = Instance.new("TextButton")
FloorBtn.Size = UDim2.new(1, -20, 0, 36)
FloorBtn.Position = UDim2.new(0, 10, 0, 102)
FloorBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
FloorBtn.BorderSizePixel = 0
FloorBtn.Text = "Floor Saver: OFF"
FloorBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
FloorBtn.Font = Enum.Font.GothamBold
FloorBtn.TextSize = 12
FloorBtn.Parent = Main
Instance.new("UICorner", FloorBtn).CornerRadius = UDim.new(0, 6)

local Status = Instance.new("TextLabel")
Status.Size = UDim2.new(1, -20, 0, 30)
Status.Position = UDim2.new(0, 10, 0, 148)
Status.BackgroundTransparency = 1
Status.Text = "Ready"
Status.TextColor3 = Color3.fromRGB(180, 180, 180)
Status.Font = Enum.Font.Gotham
Status.TextSize = 12
Status.Parent = Main

-- ============================================================
-- Floor button logic
-- ============================================================
FloorBtn.MouseButton1Click:Connect(function()
    local newState = not FloorSaver.Enabled
    setFloor(newState)
    if newState then
        FloorBtn.Text = "Floor Saver: ON"
        FloorBtn.BackgroundColor3 = Color3.fromRGB(30, 90, 50)
        FloorBtn.TextColor3 = Color3.fromRGB(0, 255, 120)
        Status.Text = "Floor spawned under you"
    else
        FloorBtn.Text = "Floor Saver: OFF"
        FloorBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
        FloorBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        Status.Text = "Floor removed"
    end
end)

-- ============================================================
-- Confirm-then-execute
-- ============================================================
local armed, armToken = false, 0

local function disarm(msg)
    armed = false
    armToken += 1
    NukeBtn.Text = "REMOVE ALL PARTS"
    NukeBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    Status.Text = msg or "Ready"
    Status.TextColor3 = Color3.fromRGB(180, 180, 180)
end

NukeBtn.MouseButton1Click:Connect(function()
    if not armed then
        armed = true
        armToken += 1
        local myToken = armToken
        NukeBtn.Text = "ARE YOU SURE? CLICK AGAIN"
        NukeBtn.BackgroundColor3 = Color3.fromRGB(220, 140, 20)
        Status.Text = "Reverting in 5s..."
        Status.TextColor3 = Color3.fromRGB(220, 180, 60)
        task.delay(5, function()
            if armed and myToken == armToken then disarm("Timed out — reverted") end
        end)
        return
    end

    armed = false
    armToken += 1
    NukeBtn.Text = "NUKE READY"
    NukeBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    Status.Text = "Removing..."
    Status.TextColor3 = Color3.fromRGB(255, 120, 120)

    task.spawn(function()
        local count = nukeParts()
        -- if floor saver is on, ensure floor exists after nuke
        if FloorSaver.Enabled then spawnFloor() end
        Status.Text = ("Removed %d parts"):format(count)
        Status.TextColor3 = Color3.fromRGB(0, 255, 120)
        NukeBtn.Text = "DONE"
        task.wait(2)
        NukeBtn.Text = "REMOVE ALL PARTS"
        NukeBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        Status.Text = "Ready"
        Status.TextColor3 = Color3.fromRGB(180, 180, 180)
    end)
end)

CloseBtn.MouseButton1Click:Connect(function()
    setFloor(false)
    ScreenGui:Destroy()
end)

-- ============================================================
-- Drag (mouse + touch)
-- ============================================================
do
    local dragging, dragStart, startPos = false, nil, nil

    Main.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end
