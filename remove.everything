CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.TextSize = 14
CloseBtn.Parent = TopBar
Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 6)

local NukeBtn = Instance.new("TextButton")
NukeBtn.Size = UDim2.new(1, -20, 0, 46)
NukeBtn.Position = UDim2.new(0, 10, 0, 42)
NukeBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
NukeBtn.BorderSizePixel = 0
NukeBtn.Text = "Remove everything"
NukeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
NukeBtn.Font = Enum.Font.GothamBold
NukeBtn.TextSize = 13
NukeBtn.Parent = Main
Instance.new("UICorner", NukeBtn).CornerRadius = UDim.new(0, 6)

local LoopBtn = Instance.new("TextButton")
LoopBtn.Size = UDim2.new(1, -20, 0, 36)
LoopBtn.Position = UDim2.new(0, 10, 0, 96)
LoopBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
LoopBtn.BorderSizePixel = 0
LoopBtn.Text = "Loop Remover"
LoopBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
LoopBtn.Font = Enum.Font.GothamBold
LoopBtn.TextSize = 12
LoopBtn.Parent = Main
Instance.new("UICorner", LoopBtn).CornerRadius = UDim.new(0, 6)

local DelayLabel = Instance.new("TextLabel")
DelayLabel.Size = UDim2.new(0.5, -14, 0, 32)
DelayLabel.Position = UDim2.new(0, 10, 0, 140)
DelayLabel.BackgroundTransparency = 1
DelayLabel.Text = "Delay"
DelayLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
DelayLabel.Font = Enum.Font.GothamBold
DelayLabel.TextSize = 12
DelayLabel.TextXAlignment = Enum.TextXAlignment.Left
DelayLabel.Parent = Main

local DelayBox = Instance.new("TextBox")
DelayBox.Size = UDim2.new(0.5, -14, 0, 32)
DelayBox.Position = UDim2.new(0.5, 4, 0, 140)
DelayBox.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
DelayBox.BorderSizePixel = 0
DelayBox.Text = "1"
DelayBox.PlaceholderText = "seconds"
DelayBox.TextColor3 = Color3.fromRGB(230, 230, 230)
DelayBox.Font = Enum.Font.Gotham
DelayBox.TextSize = 12
DelayBox.Parent = Main
Instance.new("UICorner", DelayBox).CornerRadius = UDim.new(0, 6)

local SafeBtn = Instance.new("TextButton")
SafeBtn.Size = UDim2.new(1, -20, 0, 36)
SafeBtn.Position = UDim2.new(0, 10, 0, 180)
SafeBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
SafeBtn.BorderSizePixel = 0
SafeBtn.Text = "Safe Part: OFF"
SafeBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
SafeBtn.Font = Enum.Font.GothamBold
SafeBtn.TextSize = 12
SafeBtn.Parent = Main
Instance.new("UICorner", SafeBtn).CornerRadius = UDim.new(0, 6)

local Status = Instance.new("TextLabel")
Status.Size = UDim2.new(1, -20, 0, 60)
Status.Position = UDim2.new(0, 10, 0, 224)
Status.BackgroundTransparency = 1
Status.Text = "Coin_Server + partscriptremover protected"
Status.TextColor3 = Color3.fromRGB(150, 150, 150)
Status.Font = Enum.Font.Gotham
Status.TextSize = 11
Status.TextWrapped = true
Status.Parent = Main

-- ============================================================
-- Wiring
-- ============================================================
DelayBox.FocusLost:Connect(function()
    local n = tonumber(DelayBox.Text)
    if n and n >= 0.05 and n <= 60 then
        Looper.Delay = n
        DelayBox.Text = tostring(n)
    else
        DelayBox.Text = tostring(Looper.Delay)
    end
end)

SafeBtn.MouseButton1Click:Connect(function()
    local newState = not SafePart.Enabled
    setSafePart(newState)
    if newState then
        SafeBtn.Text = "Safe Part: ON"
        SafeBtn.BackgroundColor3 = Color3.fromRGB(30, 90, 50)
        SafeBtn.TextColor3 = Color3.fromRGB(0, 255, 120)
        Status.Text = "Static slab spawned under you"
        Status.TextColor3 = Color3.fromRGB(0, 255, 120)
    else
        SafeBtn.Text = "Safe Part: OFF"
        SafeBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
        SafeBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
        Status.Text = "Slab removed"
        Status.TextColor3 = Color3.fromRGB(180, 180, 180)
    end
end)

LoopBtn.MouseButton1Click:Connect(function()
    if Looper.Enabled then
        stopLooper()
        LoopBtn.Text = "Loop Remover"
        LoopBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
        LoopBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    else
        LoopBtn.Text = "Loop Remover: ON"
        LoopBtn.BackgroundColor3 = Color3.fromRGB(30, 90, 50)
        LoopBtn.TextColor3 = Color3.fromRGB(0, 255, 120)
        startLooper(Status, LoopBtn)
    end
end)

local armed, armToken = false, 0

local function disarm(msg)
    armed = false
    armToken += 1
    NukeBtn.Text = "Remove everything"
    NukeBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    Status.Text = msg or "Coin_Server + partscriptremover protected"
    Status.TextColor3 = Color3.fromRGB(150, 150, 150)
end

NukeBtn.MouseButton1Click:Connect(function()
    if Looper.Enabled then
        Status.Text = "Turn Loop Remover OFF first"
        Status.TextColor3 = Color3.fromRGB(255, 150, 150)
        return
    end

    if not armed then
        armed = true
        armToken += 1
        local myToken = armToken
        NukeBtn.Text = "ARE YOU SURE? CLICK AGAIN"
        NukeBtn.BackgroundColor3 = Color3.fromRGB(220, 140, 20)
        Status.Text = "Reverting in 5s..."
        Status.TextColor3 = Color3.fromRGB(220, 180, 60)
        task.delay(5, function()
            if armed and myToken == armToken then disarm("Timed out — reverted") end
        end)
        return
    end

    armed = false
    armToken += 1
    NukeBtn.Text = "Removing..."
    NukeBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)

    task.spawn(function()
        local count = nukeParts()
        if SafePart.Enabled then spawnSafePart() end
        Status.Text = ("Removed %d parts"):format(count)
        Status.TextColor3 = Color3.fromRGB(0, 255, 120)
        NukeBtn.Text = "DONE"
        task.wait(2)
        NukeBtn.Text = "Remove everything"
        NukeBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        Status.Text = "Coin_Server + partscriptremover protected"
        Status.TextColor3 = Color3.fromRGB(150, 150, 150)
    end)
end)

CloseBtn.MouseButton1Click:Connect(function()
    stopLooper()
    setSafePart(false)
    ScreenGui:Destroy()
end)

-- ============================================================
-- Drag
-- ============================================================
do
    local dragging, dragStart, startPos = false, nil, nil

    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end
